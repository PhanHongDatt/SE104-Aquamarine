{
  "name": "quan-ly-cua-hang-vang-bac-da-quy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "test:logic": "ts-node -P tsconfig.test.json scripts/business-rules.test.ts",
    "test:integration": "ts-node -r tsconfig-paths/register -P tsconfig.test.json scripts/integration.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npx tsc --noEmit && npm run test:logic && npm run test:integration",
    "db:up": "docker-compose up -d",
    "db:setup": "prisma migrate deploy && prisma db seed",
    "db:studio": "prisma studio",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js",
    "postinstall": "prisma generate",
    "env:init": "node -e \"const fs = require('fs'); if (!fs.existsSync('.env')) { fs.copyFileSync('.env.example', '.env'); console.log('.env file created from .env.example'); } else { console.log('.env file already exists'); }\"",
    "setup": "node scripts/setup.js"
  },
  "prisma": {
    "seed": "ts-node -P tsconfig.test.json prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.453.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.11",
    "prisma": "^5.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-intersection-observer": "^9.13.1",
    "react-to-print": "^3.3.0",
    "recharts": "^2.15.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.39",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsconfig-paths": "^4.2.0"
  }
}
